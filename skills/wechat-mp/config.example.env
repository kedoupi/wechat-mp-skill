# WeChat Official Account API (optional — only for draft/upload)
# Writing + local preview work without these.
#
# Recommended path (default for `wechat-mp init`):
#   ~/.config/kedoupi/wechat-mp/config.env
#
# Public keys only (open-source contract). Do not put secrets only inside the
# skill package — npx skills update wipes that directory.

WECHAT_MP_APPID=wx_your_appid
WECHAT_MP_SECRET=your_appsecret
WECHAT_MP_AUTHOR=

# Optional: override API host when the official endpoint is blocked by IP whitelist
# WECHAT_MP_API_BASE=https://your-proxy.example

# Optional: point at an explicit config file (highest file priority)
# WECHAT_MP_CONFIG=/path/to/config.env
