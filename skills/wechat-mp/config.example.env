# WeChat Official Account API (optional — only for draft/upload)
# Writing + local preview work without these.
#
# Copy via:
#   bash scripts/wechat-mp init --appid wx… --secret …
# which writes durable config outside the package:
#   <skills-parent>/.skill-data/wechat-mp/config.env

WECHAT_MP_APPID=wx_your_appid
WECHAT_MP_SECRET=your_appsecret
WECHAT_MP_AUTHOR=

# Optional: WeChat API host override (IP whitelist proxy)
# WECHAT_MP_API_BASE=https://your-proxy.example
# Suite alias also works: KDP_WECHAT_PROXY / KDP_WECHAT_APPID / KDP_WECHAT_APPSECRET

# Optional: point at an explicit config file
# WECHAT_MP_CONFIG=/path/to/config.env
